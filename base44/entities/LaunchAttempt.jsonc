{
  "name": "LaunchAttempt",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "description": "Client-generated UUID; the coin mint keypair is derived from it."
    },
    "inscribedMint": {
      "type": "string",
      "description": "Source inscribed NFT mint address."
    },
    "coinMint": {
      "type": "string",
      "description": "Derived pump.fun coin mint address."
    },
    "bondingCurve": {
      "type": "string",
      "description": "pump.fun bonding curve PDA."
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "metadataUri": {
      "type": "string",
      "description": "Self-hosted metadata URI written on-chain."
    },
    "signature": {
      "type": "string",
      "description": "Latest launch transaction signature."
    },
    "lastValidBlockHeight": {
      "type": "number"
    },
    "quoteMint": {
      "type": "string"
    },
    "quoteSymbol": {
      "type": "string"
    },
    "firstBuyAmount": {
      "type": "string"
    },
    "creatorFeeBps": {
      "type": "number"
    },
    "holderReward": {
      "type": "boolean"
    },
    "feeRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "creator",
              "wallet",
              "github"
            ]
          },
          "value": {
            "type": "string"
          },
          "shareBps": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "value",
          "shareBps"
        ]
      }
    },
    "feeSharingStatus": {
      "type": "string",
      "enum": [
        "not_requested",
        "ready",
        "submitted",
        "configured",
        "failed"
      ],
      "default": "not_requested"
    },
    "feeSharingSignature": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "failed",
        "expired"
      ],
      "default": "pending"
    },
    "error": {
      "type": "string"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "requestId",
    "inscribedMint",
    "coinMint",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}