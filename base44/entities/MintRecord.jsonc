{
  "name": "MintRecord",
  "type": "object",
  "properties": {
    "mint": {
      "type": "string",
      "description": "Inscribed NFT mint contract address."
    },
    "requestId": {
      "type": "string",
      "description": "Stable client mint recovery identifier."
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "imageHash": {
      "type": "string"
    },
    "mediaHash": {
      "type": "string"
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image",
        "audio"
      ],
      "default": "image"
    },
    "mediaMime": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "destinationWallet": {
      "type": "string",
      "description": "Wallet receiving the completed NFT."
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "success",
        "failed"
      ],
      "default": "in_progress"
    },
    "errorMessage": {
      "type": "string"
    },
    "sourceUri": {
      "type": "string",
      "description": "Private source media used by the background inscription worker."
    },
    "archivedSourceUri": {
      "type": "string"
    },
    "imageUri": {
      "type": "string"
    },
    "archivedImageUri": {
      "type": "string"
    },
    "signerPublicKey": {
      "type": "string"
    },
    "signerSecretName": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "message"
        ]
      }
    },
    "totalSize": {
      "type": "number"
    },
    "imageMime": {
      "type": "string"
    },
    "batchBytes": {
      "type": "number"
    },
    "offset": {
      "type": "number",
      "default": 0
    },
    "confirmedOffsets": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "processedAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxSupply": {
      "type": "string"
    },
    "pof": {
      "type": "boolean",
      "description": "Manually submitted from the admin POF control panel."
    },
    "prepared": {
      "type": "boolean",
      "description": "False while a durable job awaits on-chain initialization."
    },
    "submissionHash": {
      "type": "string"
    },
    "coverSourceUri": {
      "type": "string"
    },
    "coverMime": {
      "type": "string"
    },
    "coverSize": {
      "type": "number"
    },
    "coverOffset": {
      "type": "number",
      "default": 0
    },
    "coverHash": {
      "type": "string"
    },
    "archivedCoverUri": {
      "type": "string"
    }
  },
  "required": [
    "mint",
    "requestId",
    "name",
    "symbol",
    "description",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}