{
  "name": "MintRecord",
  "type": "object",
  "properties": {
    "mint": {
      "type": "string",
      "description": "Inscribed NFT mint contract address."
    },
    "requestId": {
      "type": "string",
      "description": "Stable client mint recovery identifier."
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "imageHash": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "destinationWallet": {
      "type": "string",
      "description": "Public wallet that paid for the mint and receives the finished NFT."
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "success",
        "failed"
      ],
      "default": "in_progress"
    },
    "errorMessage": {
      "type": "string"
    },
    "imageUri": {
      "type": "string",
      "description": "Private source image used by the background inscription worker."
    },
    "archivedImageUri": {
      "type": "string",
      "description": "Permanent private archive of the source image, written when the mint completes."
    },
    "signerPublicKey": {
      "type": "string",
      "description": "Public key of the wallet that signs this mint's transactions."
    },
    "signerSecretName": {
      "type": "string",
      "description": "Name of the secret holding the signing wallet."
    },
    "events": {
      "type": "array",
      "description": "Append-only durable log of background inscription steps.",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "message"
        ]
      }
    },
    "totalSize": {
      "type": "number"
    },
    "imageMime": {
      "type": "string"
    },
    "batchBytes": {
      "type": "number"
    },
    "offset": {
      "type": "number",
      "default": 0
    },
    "confirmedOffsets": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "processedAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxSupply": {
      "type": "string"
    }
  },
  "required": [
    "mint",
    "requestId",
    "name",
    "symbol",
    "description",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}