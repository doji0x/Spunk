{
  "name": "Launch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "decimals": {
      "type": "integer",
      "default": 6
    },
    "supply": {
      "type": "integer",
      "description": "Total supply in whole tokens"
    },
    "priceLamports": {
      "type": "integer",
      "description": "Fixed sale price per whole token, in lamports"
    },
    "imageMime": {
      "type": "string"
    },
    "imageSize": {
      "type": "integer"
    },
    "imageHash": {
      "type": "string",
      "description": "SHA-256 hex of the uploaded image bytes"
    },
    "tokenMint": {
      "type": "string"
    },
    "nftMint": {
      "type": "string"
    },
    "inscriptionAccount": {
      "type": "string"
    },
    "imageAccount": {
      "type": "string"
    },
    "vaultAddress": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "inscribed",
        "launched",
        "on_sale",
        "closed",
        "on_curve",
        "graduated"
      ],
      "default": "preparing"
    },
    "launchStep": {
      "type": "string"
    },
    "soldTokens": {
      "type": "integer",
      "default": 0
    },
    "proceedsLamports": {
      "type": "integer",
      "default": 0
    },
    "withdrawnLamports": {
      "type": "integer",
      "default": 0
    },
    "network": {
      "type": "string",
      "enum": [
        "mainnet",
        "devnet"
      ],
      "default": "mainnet",
      "description": "Cluster this launch was created on"
    },
    "pumpMint": {
      "type": "string",
      "description": "pump.fun coin mint address"
    },
    "pumpBondingCurve": {
      "type": "string",
      "description": "pump.fun bonding curve PDA"
    },
    "pumpUri": {
      "type": "string",
      "description": "Immutable metadata URI carrying the inscription binding"
    },
    "pumpPoolAddress": {
      "type": "string",
      "description": "PumpSwap pool address after graduation"
    },
    "probeLog": {
      "type": "array",
      "description": "Per-step devnet probe costs and signatures",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "lamports": {
            "type": "integer"
          },
          "fee": {
            "type": "integer"
          },
          "computeUnits": {
            "type": "integer"
          },
          "at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "symbol",
    "description",
    "supply",
    "priceLamports",
    "imageMime",
    "imageSize",
    "imageHash"
  ]
}