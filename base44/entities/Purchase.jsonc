{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "launchId": {
      "type": "string"
    },
    "signature": {
      "type": "string",
      "description": "Buyer's SOL payment transaction signature"
    },
    "buyer": {
      "type": "string"
    },
    "lamports": {
      "type": "integer"
    },
    "tokens": {
      "type": "integer",
      "description": "Whole tokens delivered"
    },
    "transferSignature": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "launchId",
    "signature",
    "buyer",
    "lamports",
    "tokens"
  ]
}